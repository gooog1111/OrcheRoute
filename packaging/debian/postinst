#!/bin/sh
set -e

core_was_active=0
if systemctl is-active --quiet orcheroute-core.service; then
    core_was_active=1
fi

install -d -m 0750 /etc/orcheroute
install -d -m 0700 /var/lib/orcheroute
install -d -m 0700 /var/backups/orcheroute

# Versions before the embedded AWG backend created this exact WireGuard
# interface from this package-owned configuration. Its more-specific
# 10.77.0.0/24 route steals replies from the new orchecall0 network. Leave the
# legacy configuration and state on disk for rollback, but retire its live
# interface before starting the current service. Never remove an interface
# merely because its address overlaps: the config file is the ownership gate.
legacy_reverse_config=/var/lib/orcheroute/reverse-vpn/or-reverse.conf
if [ -f "$legacy_reverse_config" ] && ip link show dev or-reverse >/dev/null 2>&1; then
    echo "Migrating legacy OrcheRoute reverse VPN interface..."
    if command -v wg-quick >/dev/null 2>&1; then
        wg-quick down "$legacy_reverse_config" >/dev/null 2>&1 || true
    fi
    if ip link show dev or-reverse >/dev/null 2>&1; then
        ip link delete dev or-reverse
    fi
fi

preserved_mihomo=/var/lib/orcheroute/packages/mihomo-before-package
packaged_mihomo=/opt/orcheroute/bin/mihomo
if [ -x "$preserved_mihomo" ] && [ -x "$packaged_mihomo" ]; then
    preserved_version=$($preserved_mihomo -v 2>/dev/null | sed -n 's/.*[vV]\([0-9][0-9.]*\).*/\1/p' | head -n 1)
    packaged_version=$($packaged_mihomo -v 2>/dev/null | sed -n 's/.*[vV]\([0-9][0-9.]*\).*/\1/p' | head -n 1)
    if [ -n "$preserved_version" ] && [ -n "$packaged_version" ] && dpkg --compare-versions "$preserved_version" gt "$packaged_version"; then
        install -m 0755 "$preserved_mihomo" "$packaged_mihomo"
    fi
fi
rm -f "$preserved_mihomo"

credentials=$(/opt/orcheroute/bin/orcheroute-bootstrap --output /etc/orcheroute/runtime.env)
chmod 0640 /etc/orcheroute/runtime.env
if [ -n "$credentials" ]; then
    printf '%s\n' "$credentials" > /etc/orcheroute/initial-credentials
    chmod 0600 /etc/orcheroute/initial-credentials
    echo "OrcheRoute WebUI credentials:"
    printf '%s\n' "$credentials"
    echo "Saved in /etc/orcheroute/initial-credentials"
else
    # A file from an earlier bootstrap must never advertise credentials that
    # no longer match runtime.env.
    rm -f /etc/orcheroute/initial-credentials
fi
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable orcheroute-go.service >/dev/null
systemctl restart orcheroute-go.service
systemctl enable --now orcheroute-update.timer orcheroute-geo.timer
if [ "$core_was_active" -eq 1 ]; then
    # Preserve the running state even when converting a manual installation
    # into a dpkg-managed one. A clean install remains stopped.
    systemctl enable orcheroute-routing.service orcheroute-core.service >/dev/null 2>&1 || true
    systemctl restart orcheroute-routing.service orcheroute-core.service
fi

echo
echo "OrcheRoute Server is installed."
echo "Login method: HTTP Basic authentication"
echo "WebUI addresses:"
printf '  http://127.0.0.1:19110/\n'
for address in $(hostname -I 2>/dev/null || true); do
    case "$address" in *:*) ;; *) printf '  http://%s:19110/\n' "$address" ;; esac
done
if [ -s /etc/orcheroute/initial-credentials ]; then
    echo "Credentials:"
    sed 's/^/  /' /etc/orcheroute/initial-credentials
else
    username=$(sed -n 's/^webui_username=//p' /etc/orcheroute/runtime.env | head -n 1)
    printf 'Username: %s\n' "${username:-admin}"
    echo "Password: existing password retained (not recoverable from its hash)"
fi
echo "Credentials file: sudo cat /etc/orcheroute/initial-credentials"
echo "Service status: systemctl status orcheroute-go --no-pager"
if systemctl is-active --quiet orcheroute-go.service; then
    echo "Control plane: running"
else
    echo "Control plane: FAILED"
    systemctl status orcheroute-go.service --no-pager || true
    exit 1
fi
if systemctl is-active --quiet orcheroute-core.service; then
    echo "VPN transport: configured and started"
else
    echo "VPN transport: ready, waiting for the first Enable command in WebUI"
fi
if ! command -v nft >/dev/null 2>&1; then
    echo "WARNING: nftables is not installed. WebUI is available, but VPN routing requires: apt install nftables"
fi
if ! command -v iptables >/dev/null 2>&1; then
    echo "WARNING: iptables is not installed. WebUI is available, but the inbound AWG server requires: apt install iptables"
fi
exit 0
