#!/bin/sh
set -e

core_was_active=0
if systemctl is-active --quiet orcheroute-core.service; then
    core_was_active=1
fi

install -d -o root -g root -m 0700 /etc/orcheroute
install -d -m 0700 /var/lib/orcheroute
credentials=$(/opt/orcheroute/bin/orcheroute-bootstrap --output /etc/orcheroute/runtime.env)
if [ -n "$credentials" ]; then
    printf '%s\n' "$credentials" > /etc/orcheroute/initial-credentials
    chmod 0600 /etc/orcheroute/initial-credentials
fi
chown root:root /etc/orcheroute /etc/orcheroute/runtime.env
chmod 0700 /etc/orcheroute
chmod 0600 /etc/orcheroute/runtime.env

systemctl daemon-reload >/dev/null 2>&1 || true
if [ -z "${2:-}" ]; then
    # A clean desktop install is ready to start, but never captures traffic by
    # itself. Upgrades preserve the user's enabled/disabled systemd state.
    systemctl disable --now orcheroute-core.service orcheroute-routing.service >/dev/null 2>&1 || true
fi
systemctl enable orcheroute-go.service >/dev/null
systemctl restart orcheroute-go.service
if ! systemctl is-active --quiet orcheroute-go.service; then
    systemctl status orcheroute-go.service --no-pager || true
    exit 1
fi
if [ -n "${2:-}" ] && [ "$core_was_active" -eq 1 ]; then
    # Preserve the exact runtime state: reload the upgraded Mihomo binary only
    # when the VPN was already running. A stopped VPN remains stopped.
    systemctl restart orcheroute-core.service
fi
systemctl enable --now orcheroute-update.timer orcheroute-geo.timer >/dev/null 2>&1 || true
systemctl start --no-block orcheroute-update.service >/dev/null 2>&1 || true
update-desktop-database >/dev/null 2>&1 || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
exit 0
