#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = upgrade ] || [ "$1" = deconfigure ]; then
	pkill -TERM -f '^/usr/lib/orcheroute/orcheroute-desktop-bin([[:space:]]|$)' >/dev/null 2>&1 || true
	count=0
	while pgrep -f '^/usr/lib/orcheroute/orcheroute-desktop-bin([[:space:]]|$)' >/dev/null 2>&1 && [ "$count" -lt 20 ]; do
		sleep 0.1
		count=$((count + 1))
	done
	pkill -KILL -f '^/usr/lib/orcheroute/orcheroute-desktop-bin([[:space:]]|$)' >/dev/null 2>&1 || true
	if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
		systemctl disable --now orcheroute-update.timer orcheroute-geo.timer >/dev/null 2>&1 || true
		systemctl disable --now orcheroute-go.service orcheroute-core.service orcheroute-routing.service >/dev/null 2>&1 || true
	fi
fi
exit 0
