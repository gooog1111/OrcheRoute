[Unit]
Description=Apply a staged OrcheRoute network profile with transactional rollback (Go)
After=network-online.target orcheroute-routing.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/var/lib/orcheroute
ExecStart=/opt/orcheroute/bin/orcheroute-network-go --action apply-staged --confirm-system-capture
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=false
