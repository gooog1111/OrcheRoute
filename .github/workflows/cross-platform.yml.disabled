name: Cross-platform verification

on:
  workflow_dispatch:
  push:
  pull_request:

concurrency:
  group: cross-platform-${{ github.ref }}
  cancel-in-progress: true

jobs:
  windows:
    name: Windows Server + Desktop
    runs-on: windows-2025
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: webui/package-lock.json
      - name: Install Wails
        shell: pwsh
        run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.13.0
      - name: Verify Windows targets
        shell: pwsh
        run: go run ./cmd/orcheroute-build -target windows
      - uses: actions/upload-artifact@v4
        if: success()
        with:
          name: verify-windows
          retention-days: 7
          path: |
            dist/verify/windows-server/*
            desktop/build/bin/*

  linux:
    name: Linux Server + Desktop
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: webui/package-lock.json
      - name: Install Linux Desktop dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends build-essential pkg-config libgtk-3-dev libwebkit2gtk-4.1-dev
          go install github.com/wailsapp/wails/v2/cmd/wails@v2.13.0
      - name: Verify Linux targets
        run: go run ./cmd/orcheroute-build -target linux
      - uses: actions/upload-artifact@v4
        if: success()
        with:
          name: verify-linux
          retention-days: 7
          path: |
            dist/verify/linux-server/*
            desktop/build/bin/*

  android:
    name: Android
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: webui/package-lock.json
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
          cache: gradle
      - uses: android-actions/setup-android@v3
      - name: Install Android toolchain
        run: |
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager "platforms;android-36" "build-tools;36.0.0" "ndk;28.2.13676358"
          go install golang.org/x/mobile/cmd/gomobile@latest
          gomobile init
      - name: Verify Android target
        run: go run ./cmd/orcheroute-build -target android
      - uses: actions/upload-artifact@v4
        if: success()
        with:
          name: verify-android
          retention-days: 7
          path: android/app/build/outputs/apk/debug/app-debug.apk
