#!/usr/bin/env sh
set -eu

# OrcheRoute deliberately has no GitHub Actions. Builds and releases are local.
# Keep this hook fast: required target tests are selected and run explicitly.
if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '^\.github/workflows/.*\.(yml|yaml)$'; then
  echo "GitHub Actions are prohibited for OrcheRoute; disable the workflow file." >&2
  exit 1
fi
